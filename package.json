{
  "name": "modpilot-ai",
  "version": "2.0.0",
  "description": "ModPilot - Production-Ready Minecraft Mod Creation & Publishing Platform",
  "private": false,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:integration": "jest --testMatch='**/__tests__/**/*.test.ts?(x)'",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "lucide-react": "^0.263.0",
    "zustand": "^4.4.0",
    "axios": "^1.5.0",
    "react-hot-toast": "^2.4.1",
    "@anthropic-ai/sdk": "^0.120.0",
    "openai": "^4.52.0",
    "@google/generative-ai": "^0.3.0",
    "dotenv": "^16.3.1",
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "next-auth": "^4.24.0",
    "zod": "^3.22.4",
    "next-safe-action": "^7.4.0",
    "react-dropzone": "^14.2.3",
    "ms": "^2.1.3",
    "slug": "^6.1.0",
    "crypto-random-string": "^5.0.0",
    "nanoid": "^4.0.0",
    "sharp": "^0.32.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "prisma": "^5.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@playwright/test": "^1.40.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0"
  }
}
