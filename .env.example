# Environment Variables for ModPilot

# ========== DATABASE ==========
DATABASE_URL="postgresql://user:password@localhost:5432/modpilot"

# ========== AUTHENTICATION ==========
AUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ========== AI PROVIDERS ==========
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="your-gemini-api-key"
GROK_API_KEY="your-grok-api-key"

# ========== FILE STORAGE ==========
# Using Vercel Blob or AWS S3
STORAGE_TYPE="vercel-blob"
STORAGE_TOKEN="your-vercel-blob-token"

# OR for S3:
# STORAGE_TYPE="s3"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_S3_BUCKET="modpilot-uploads"
# AWS_S3_REGION="us-east-1"

# ========== BUILD SYSTEM ==========
BUILD_QUEUE_URL="http://localhost:3001"
MAX_BUILD_TIMEOUT_MS=3600000

# ========== ADMIN ==========
ADMIN_EMAIL="tyroxyt200@gmail.com"

# ========== APP CONFIG ==========
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_NAME="ModPilot"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NODE_ENV="development"
